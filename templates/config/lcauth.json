{
  "auth": {
    "disable_seeding": false,
    "seed_testing": false,
    "session_cookie_name": "langcities_auth",
    "session_cookie_secret": "replace-this-with-a-long-random-development-session-cookie-secret",
    "disable_session_cookie_http_only": false,
    "session_cookie_samesite": "Lax",
    "session_cookie_expiry": null,
    "session_cookie_reset_expiry_on_active": false,
    "disable_session_cookie_secure": false,
    "session_cookie_path": "/",
    "session_cookie_domain": null,
    "session_cookie_always_save": false
  },
  "server": {
    "bind_address": "0.0.0.0",
    "bind_port": 8000
  },
  "db": {
    "url": "sqlite:///data/auth.sqlite?mode=rwc",
    "max_connections": 10,
    "min_connections": 1,
    "connect_timeout": 30000,
    "idle_timeout": 600000,
    "acquire_timeout": 30000,
    "max_lifetime": 1800000,
    "sqlx_logging": true,
    "record_stmt_in_spans": true,
    "sqlx_logging_level": "Info",
    "sqlx_slow_statements_logging_level": "Off",
    "sqlx_slow_statements_logging_threshold": 1000,
    "sqlcipher_key": null,
    "schema_search_path": null,
    "application_name": "langcities-auth",
    "statement_timeout": null,
    "test_before_acquire": true,
    "test_before_acquire_if_idle_for": 60000,
    "connect_lazy": false
  },
  "jwt": {
    "hmac_secret": "replace-this-with-a-long-random-development-jwt-secret",
    "algorithm": "HS256",
    "expiry": 600000,
    "issuer": "http://localhost:8000"
  }
}
