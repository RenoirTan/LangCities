# Copy this file to a local environment file used for Docker Compose interpolation.
# These paths select host files and are not passed into the application containers.

# Host path to the auth JSON configuration, mounted read-only at /app/lcauth.json.
LCAUTH_CONFIG_PATH=
# Host path to the DC JSON configuration, mounted read-only at /app/lcdc.json.
LCDC_CONFIG_PATH=

# Directory containing the sqlite files for auth, mounted at /data/db/auth/
LCAUTH_SQLITE_DIR=
# Directory containing the sqlite files for dc, mounted at /data/db/dc/
LCDC_SQLITE_DIR=

# User to run the microservices as. If left blank, docker uses root as the default.
# It is recommended to set a non-root user, such as 1000:1000 as the value of this variable
LC_USER=
